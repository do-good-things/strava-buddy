# Web service and worker: browser-safe Mapbox token.
MAPBOX_TOKEN=
PORT=3000

# Worker only; never add Strava credentials to the web service.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# One-time authorization bootstrap. Subsequent rotations persist on the volume.
STRAVA_REFRESH_TOKEN=
# Railway: mount a worker-only volume here. Local default: .runtime/private.
# PRIVATE_DATA_DIR=/data/private

# Railway services: set s3. Local default uses .runtime/published.
STORAGE_BACKEND=local
# PUBLISHED_DIR=/path/to/local/published
AWS_ENDPOINT_URL=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
S3_FORCE_PATH_STYLE=false
